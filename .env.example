# =========================
# Smart-Notifier 配置示例
# =========================

# 应用基础信息
APP_NAME=Smart Notifier
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# PostgreSQL 异步连接 URL（必须使用 asyncpg 驱动）
# 格式：postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# 示例：postgresql+asyncpg://postgres:postgres@db:5432/smart_notifier
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/smart_notifier

# Telegram Bot Token（从 @BotFather 获取）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram polling 间隔（秒）
TELEGRAM_POLL_INTERVAL=1.0

# APScheduler 时区
SCHEDULER_TIMEZONE=Asia/Shanghai

# Web 管理端 Basic Auth 用户名
WEB_USERNAME=admin

# Web 管理端 Basic Auth 密码（请务必修改为强密码）
WEB_PASSWORD=change_me
